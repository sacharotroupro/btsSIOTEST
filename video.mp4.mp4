olorPalette":{"baseBackground":4293982207,"raisedBackground":4293982207,"additiveBackground":557285847,"textPrimary":4278459964,"textSecondary":4279783568,"invertedBackground":4279783568,"overlayBackground":3422821948},"darkThemeColorPalette":{"baseBackground":4278259230,"raisedBackground":4278459964,"additiveBackground":725058007,"textPrimary":4292734205,"textSecondary":4288201201,"invertedBackground":4286098664,"overlayBackground":3422821948},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBwQ040EGAkiEwiFq4fPkIeXAxU_AWMBHTgmEQfKAQSzfcHh","commandMetadata":{"webCommandMetadata":{"url":"/@abnetworks-g6z","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC_RcIo0lA6Z4-1GEKt4qYbg","canonicalBaseUrl":"/@abnetworks-g6z"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/hp3xl7ZPpuIZ9q47H-2fpF3J6pDpVX0jI0VysUa856qm1fP-Ywl9w-PZRRllfb9A9xhtQuxy3_U=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Plus"}},"simpleText":"...afficher plus"},"showLessText":{"simpleText":"Moins"},"attributedDescriptionBodyText":{"content":"🚨 STOP aux idées reçues sur le métier d'Ingénieur Réseau !\n\nDans cette vidéo, je vous révèle CE QUE FAIT VRAIMENT un ingénieur réseau en 2025 :\n✅ La VRAIE journée type (pas celle des films !)\n✅ Les missions concrètes au quotidien\n✅ Les salaires RÉELS par expérience (débutant à expert)\n✅ Les environnements de travail (ESN, entreprises, freelance)\n✅ Les évolutions de carrière possibles\n✅ Les défis et opportunités 2025\n\n🎯 Que vous soyez étudiant IT ou en reconversion, cette vidéo vous donnera une vision AUTHENTIQUE du métier.\n\n📊 TIMESTAMPS :\n00:00 - Hook : L'appel d'urgence 7h45\n01:15 - Journée type d'un ingénieur réseau\n04:30 - Contexte employeurs et environnements\n07:00 - Salaires et évolutions carrière\n11:0